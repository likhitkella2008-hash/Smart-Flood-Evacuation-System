# =========================================================
# SMART FLOOD EVACUATION & RESCUE SYSTEM - CONFIGURATION
# =========================================================

# Flask Secret Key for Session Security
FLASK_SECRET_KEY=replace_with_a_long_random_secure_secret_key_2026

# SMS Notification Provider Configuration
# Options: "console" (simulator fallback, default) or "twilio" (for real SMS)
SMS_PROVIDER=console

# Twilio API Credentials (Required ONLY if SMS_PROVIDER=twilio)
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+1234567890
